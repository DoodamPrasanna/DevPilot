# Shared project configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://127.0.0.1:5173
MONGODB_URI=mongodb://localhost:27017/devpilot
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRES_IN=1d
COOKIE_NAME=devpilot_token
MAX_REPOSITORY_FILE_SIZE_BYTES=1048576
MAX_REPOSITORY_CONTEXT_FILES=6
MAX_REPOSITORY_CONTEXT_FILE_CHARS=10000
MAX_REPOSITORY_CONTEXT_TOTAL_CHARS=24000
MAX_REPOSITORY_CONTEXT_TREE_ENTRIES=250
MAX_REPOSITORY_CONTEXT_DIRECTORY_DEPTH=3
MAX_REPOSITORY_CONTEXT_TREE_REQUESTS=8
MAX_REPOSITORY_INDEX_FILES=100
MAX_REPOSITORY_INDEX_TREE_ENTRIES=2000
MAX_REPOSITORY_INDEX_TREE_REQUESTS=100
MAX_REPOSITORY_INDEX_TOTAL_CHARS=500000
MAX_REPOSITORY_CHUNK_CHARS=3000
MAX_REPOSITORY_RETRIEVED_CHUNKS=6
MAX_REPOSITORY_RETRIEVAL_CHARS=24000
ATLAS_VECTOR_INDEX_NAME=devpilot_repository_chunks
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Gemini is server-only. The key is optional; replace the placeholder to enable chat.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
